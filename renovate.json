{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":pinAllExceptPeerDependencies", "helpers:pinGitHubActionDigests"],
  "timezone": "America/New_York",
  "schedule": ["before 6am on monday"],
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": { "labels": ["security"], "schedule": ["at any time"] },
  "lockFileMaintenance": { "enabled": true },
  "nix": { "enabled": true },
  "github-actions": { "managerFilePatterns": ["/(^|/)\\.(forgejo|github)/workflows/[^/]+\\.ya?ml$/"] },
  "packageRules": [
    { "matchManagers": ["npm"], "matchDepTypes": ["devDependencies"], "groupName": "site dev dependencies" },
    { "matchManagers": ["github-actions"], "groupName": "CI actions" },
    { "matchManagers": ["nix"], "groupName": "flake inputs" }
  ]
}
